# Copy to /opt/infinitive-bucket/.env on the server, chmod 600. Never commit the real file.
NODE_ENV=production
APP_URL=https://app.bucket.infinitivecloud.com
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://bucket:CHANGE_ME@postgres:5432/bucket
S3_ENDPOINT_INTERNAL=http://127.0.0.1:8333
S3_ENDPOINT_PUBLIC=https://s3.bucket.infinitivecloud.com
S3_REGION=us-east-1
S3_ADMIN_ACCESS_KEY=CHANGE_ME
S3_ADMIN_SECRET_KEY=CHANGE_ME
AUTH_SECRET=CHANGE_ME_run_npm_run_gen_secrets
AUTH_TRUST_HOST=true
METRICS_TOKEN=CHANGE_ME
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Infinitive Cloud Bucket <no-reply@infinitivecloud.com>
SEED_SUPERADMIN_EMAIL=CHANGE_ME
SEED_SUPERADMIN_PASSWORD="CHANGE_ME"
SEED_DEMO=false
