# Dev defaults (throw-away credentials, safe to commit)
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://bucket:bucket@127.0.0.1:5432/bucket
S3_ENDPOINT_INTERNAL=http://127.0.0.1:8333
S3_ENDPOINT_PUBLIC=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ADMIN_ACCESS_KEY=devadminkey
S3_ADMIN_SECRET_KEY=devadminsecret
AUTH_SECRET=dev-only-secret-change-me-dev-only-secret
AUTH_TRUST_HOST=true
METRICS_TOKEN=dev-metrics-token
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Infinitive Cloud Bucket <no-reply@localhost>
SEED_SUPERADMIN_EMAIL=superadmin@infinitivecloud.com
SEED_SUPERADMIN_PASSWORD="Super@Bucket#2026"
SEED_DEMO=true
